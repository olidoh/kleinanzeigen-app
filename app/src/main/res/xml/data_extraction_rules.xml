<?xml version="1.0" encoding="utf-8"?>
<!-- Der API-Schlüssel ist an den Android Keystore dieses Geräts gebunden und wird nicht gesichert. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
